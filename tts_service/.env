# ── TTS Model ─────────────────────────────────────────────────────
TTS_MODEL=kokoro
TTS_DEVICE=cuda
TTS_DTYPE=bfloat16
TTS_OPENVOICE_LANGUAGE=EN
# ── Voice ─────────────────────────────────────────────────────────
# For Chatterbox: "default" uses built-in voice, or set to a .wav path for cloning
TTS_DEFAULT_VOICE=default

# ── Audio output ──────────────────────────────────────────────────
TTS_SAMPLE_RATE=24000
TTS_AUDIO_FORMAT=wav

# ── Streaming ─────────────────────────────────────────────────────
TTS_STREAM_CHUNK_SIZE=4096
TTS_STREAM_SENTENCE_BOUNDARY=true

# ── Cache ─────────────────────────────────────────────────────────
# Reuses the same Redis instance as techer_llm
REDIS_URL=redis://localhost:6379/0
TTS_CACHE_ENABLED=true
TTS_CACHE_TTL_SECONDS=3600
TTS_CACHE_MAX_TEXT_CHARS=2000

# ── Service ───────────────────────────────────────────────────────
TTS_HOST=0.0.0.0
TTS_PORT=5000
TTS_MAX_TEXT_LENGTH=2000
TTS_REQUEST_TIMEOUT_SECONDS=60

# ── Prosody limits ────────────────────────────────────────────────
TTS_RATE_MIN=0.75
TTS_RATE_MAX=1.30

# ── Integration ───────────────────────────────────────────────────
# URL of the techer_llm service (not used by TTS directly, for reference)
TEACHER_SERVICE_URL=http://127.0.0.1:8000