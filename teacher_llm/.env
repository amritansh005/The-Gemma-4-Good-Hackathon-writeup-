LLM_MODEL=gemma3:4b
LLM_TEMPERATURE=0.3
#LLM_NUM_PREDICT=120
LLM_TOP_P=0.85
LLM_REPEAT_PENALTY=1.1
ENABLE_STREAMING=true

SUMMARY_MODEL=gemma3:4b
SUMMARY_TEMPERATURE=0.1

RECALL_MODEL=gemma3:4b
RECALL_TEMPERATURE=0.0

MEMORY_CARD_MODEL=gemma3:4b
MEMORY_CARD_TEMPERATURE=0.0

EMBEDDING_MODEL=nomic-embed-text

REDIS_URL=redis://localhost:6379/0
SQLITE_DB_PATH=chat_history.db

MAX_RECENT_MESSAGES=12
MAX_PROMPT_HISTORY_MESSAGES=4
MEMORY_CARD_WINDOW_MESSAGES=4

BG_LLM_MODEL=gemma3:4b

OLLAMA_NUM_CTX=4096

OLLAMA_FG_HOST=http://127.0.0.1:11434
OLLAMA_BG_HOST=http://127.0.0.1:11434

OLLAMA_BG_NUM_CTX=4096